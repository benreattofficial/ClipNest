<Window x:Class="ClipNest.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Height="610" Width="780" MinHeight="560" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="SettingsTabs" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="{DynamicResource TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource GeneralDescription}" FontSize="15" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StorageLocation}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="StoragePathText" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14" />
                                <Button x:Name="OpenFolderButton" Content="{DynamicResource OpenFolder}" HorizontalAlignment="Left" Click="OpenFolder_Click" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                            <TextBlock Text="{DynamicResource SensitiveHint}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource TabLanguage}">
                <StackPanel Margin="20">
                    <TextBlock Text="{DynamicResource LanguageTitle}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource LanguageDescription}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />
                    <ComboBox x:Name="LanguageCombo" Width="280" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged" />
                    <TextBlock Text="English · Türkçe · Français · Español · Русский · 简体中文 · Deutsch" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource TabAppearance}">
                <StackPanel Margin="20">
                    <TextBlock Text="{DynamicResource ThemeTitle}" FontSize="17" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeCombo" Width="280" HorizontalAlignment="Left" Margin="0,8,0,22" SelectionChanged="ThemeCombo_SelectionChanged" />
                    <TextBlock Text="{DynamicResource AccentTitle}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource AccentDescription}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <ComboBox x:Name="AccentCombo" Width="280" HorizontalAlignment="Left" SelectionChanged="AccentCombo_SelectionChanged" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource TabAdvanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <CheckBox x:Name="StartupCheck" Content="{DynamicResource StartupTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource StartupDescription}" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,14" TextWrapping="Wrap" />
                        <CheckBox x:Name="MinimizedCheck" Content="{DynamicResource MinimizedTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource MinimizedDescription}" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,14" TextWrapping="Wrap" />
                        <CheckBox x:Name="MonitorCheck" Content="{DynamicResource MonitorTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource MonitorDescription}" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,14" TextWrapping="Wrap" />
                        <CheckBox x:Name="ConfirmClearCheck" Content="{DynamicResource ConfirmClear}" FontSize="14" Margin="0,0,0,18" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource MaxHistory}" VerticalAlignment="Center" />
                            <TextBox x:Name="MaxItemsBox" Grid.Column="1" MaxLength="4" Padding="9,6" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource PollInterval}" VerticalAlignment="Center" />
                            <ComboBox x:Name="PollIntervalCombo" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" Margin="0,0,14,0" />
            <Button Content="{DynamicResource Cancel}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Save}" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
