<Window x:Class="ClipNest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipNest" Height="740" Width="1040" MinHeight="580" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" Icon="pack://application:,,,/Assets/ClipNest.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="ClipNest" FontSize="29" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource Subtitle}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                <TextBlock Text="{DynamicResource SensitiveHint}" FontSize="12" Foreground="#A16207" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="MonitoringLabel" Text="{DynamicResource MonitoringOn}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsButton" Content="{DynamicResource Settings}" Click="OpenSettings_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,2" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock Text="⌕" FontSize="23" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="SearchBox" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" Padding="0,12"
                             Background="Transparent" ToolTip="{DynamicResource Search}" TextChanged="SearchBox_TextChanged" />
                </DockPanel>
            </Border>
            <Button x:Name="ToggleMonitoringButton" Grid.Column="1" Content="{DynamicResource Pause}" Click="ToggleMonitoring_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="CountLabel" Text="{DynamicResource History}" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="ClearButton" Content="{DynamicResource ClearUnpinned}" HorizontalAlignment="Right" Padding="10,6" Background="Transparent" Foreground="{DynamicResource MutedBrush}" FontSize="12" Click="ClearButton_Click" />
        </Grid>
        <Border Grid.Row="3" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource PinnedMarker}" Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding DateAdded, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Copy}" Tag="{Binding}" Click="CopyButton_Click" Margin="0,0,8,0" />
                                            <Button Tag="{Binding}" Click="PinButton_Click" Margin="0,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="{DynamicResource Pin}" />
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Content" Value="{DynamicResource Unpin}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{DynamicResource Delete}" Tag="{Binding}" Click="DeleteButton_Click" Margin="8,0,0,0" Background="Transparent" Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                    <TextBlock Text="▤" FontSize="42" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource EmptyHistory}" FontSize="15" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="2,12,0,0">
            <TextBlock x:Name="StatusLabel" Text="{DynamicResource Ready}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            <TextBlock x:Name="LocalOnlyLabel" Text="{DynamicResource LocalOnly}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
        </Grid>
    </Grid>
</Window>